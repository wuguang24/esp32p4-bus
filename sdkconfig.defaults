# 板级 / 工程默认（首次 configure 合并）
CONFIG_IDF_TARGET="esp32p4"

# —— 尽量吃满 P4 ——
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_CACHE_L2_CACHE_512KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# —— LVGL 9 ——
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_DRAW_BUF_ALIGN=128
# CONFIG_LV_USE_PPA is not set
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_16_CJK=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_DEF_REFR_PERIOD=16
# 勿用 builtin 静态堆：128KB 会顶穿 ESP32-P4 内部 DRAM（BSS 盖住 ROM 区）→ 启动即 LP_WDT
# CLIB malloc 走 heap，大块自动进 PSRAM
# CONFIG_LV_USE_BUILTIN_MALLOC is not set
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_OBJ_STYLE_CACHE=y
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_USE_DEMO_WIDGETS is not set

# DMA2D：XIP 时 PPA on_job_picked 在 PSRAM，不能开 ISR_IRAM_SAFE（会 ESP_ERR_INVALID_ARG）
CONFIG_DMA2D_OPERATION_FUNC_IN_IRAM=y
# CONFIG_DMA2D_ISR_IRAM_SAFE is not set

# FreeRTOS 1ms tick（总线时间戳 / UI 定时器）
CONFIG_FREERTOS_HZ=1000

# UI 首建/整定刷新较慢，避免 task_wdt 误报
CONFIG_ESP_TASK_WDT_TIMEOUT_S=60

# —— 内部 DMA RAM：Hosted SDIO mempool 必须用 INTERNAL|DMA，与参考工程一致 ——
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
# CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP is not set
# Hosted/SDIO 已先占内部 DMA；PPA 后再申 32K 连续块常失败，故降为 16K
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=16384

# —— ESP-Hosted WiFi（慧勤智远板：C6 SDIO 49–54，RST=19） ——
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=53
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=54
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=49
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=50
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=51
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=52
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=19
CONFIG_ESP_HOSTED_GPIO_SLAVE_RESET_SLAVE=19
CONFIG_ESP_HOSTED_DFLT_TASK_FROM_SPIRAM=y
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
